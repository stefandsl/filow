{
  "name": "@intelliprompter/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A teleprompter that checks off your talking points as you say them. OpenRouter decisions, live transcription.",
  "author": "Stefan Butnaru",
  "license": "MIT",
  "homepage": "https://github.com/stefandsl/intelliprompter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "icon": "node ../../scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.intelliprompter.app",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "artifactName": "Intelliprompter-${version}-${os}-${arch}.${ext}",
    "productName": "Intelliprompter",
    "directories": { "output": "../../release", "buildResources": "build" },
    "files": ["main.js", "preload.js", "build/icon.png", "package.json"],
    "asar": true,
    "extraResources": [
      { "from": "../web/.next/standalone", "to": "app", "filter": ["**/*", "!**/.env*"] },
      { "from": "../server/dist/bundle.js", "to": "server/bundle.js" },
      { "from": "../web/.env.example", "to": ".env.example" },
      { "from": "../web/script.md", "to": "script.md" }
    ],
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "portable": { "artifactName": "Intelliprompter-${version}-win-x64-portable.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Stefan Butnaru"
    }
  }
}
