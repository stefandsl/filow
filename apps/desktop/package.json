{
  "name": "@filow/desktop",
  "version": "0.9.31",
  "private": true,
  "description": "Filow: the live speaking companion",
  "author": "VoidExploit",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/stefandsl/filow",
  "main": "main.js",
  "desktopName": "Filow.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "icon": "node ../../scripts/make-icon.js",
    "vendor": "esbuild ../../node_modules/electron-updater/out/main.js --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=vendor/electron-updater.js && npm run build:welcome",
    "predist": "npm run vendor",
    "predist:win": "npm run vendor",
    "predist:mac": "npm run vendor",
    "predist:linux": "npm run vendor",
    "build:welcome": "esbuild welcome.ts --bundle --platform=browser --target=chrome130 --outfile=vendor/welcome.js && esbuild i18n=../../packages/core/src/i18n/index.ts ui-preferences=../../packages/core/src/ui-preferences.ts profile=../../packages/core/src/profile.ts hardware=../../packages/core/src/hardware.ts --bundle --platform=node --format=cjs --outdir=vendor && esbuild ../web/app/theme-tokens.css --bundle --outfile=vendor/theme-tokens.css",
    "prestart": "npm run build:welcome",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target es2022 --moduleResolution bundler --module esnext --jsx react-jsx welcome.ts"
  },
  "devDependencies": {
    "@filow/core": "*",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "0.28.2"
  },
  "build": {
    "beforePack": "./before-pack.js",
    "appId": "com.intelliprompter.app",
    "electronVersion": "45.2.3",
    "npmRebuild": false,
    "afterPack": "./after-pack.js",
    "artifactName": "Filow-${version}-${os}-${arch}.${ext}",
    "productName": "Filow",
    "executableName": "Filow",
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "slideshow.js",
      "points-window.js",
      "localai.js",
      "stt-worker.js",
      "stt.js",
      "stt-download.js",
      "dictation.js",
      "dictation-core.js",
      "download.js",
      "tts.js",
      "tts-worker.js",
      "tunnels.js",
      "csp.js",
      "secrets.js",
      "qa.js",
      "integrity.js",
      "diag.js",
      "single-instance.js",
      "mac-permissions.js",
      "about.js",
      "about-preload.js",
      "about.html",
      "about-page.js",
      "about.css",
      "preload.js",
      "splash.html",
      "vendor/*.js",
      "picker.html",
      "picker-preload.js",
      "build/icon.png",
      "build/icon.ico",
      "build/wordmark-white.svg",
      "build/wordmark-black.svg",
      "package.json",
      "welcome.html",
      "welcome-preload.js",
      "welcome-setup.js",
      "ui-preferences.js",
      "vendor/*.css",
      "okfilow.js",
      "okfilow-preload.js",
      "okfilow-gestures.js",
      "okfilow-agents.js",
      "okfilow-selection.js",
      "okfilow-answers.js",
      "okfilow-outbound.js"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../web/.next/standalone",
        "to": "app",
        "filter": [
          "**/*",
          "!**/.env*"
        ]
      },
      {
        "from": "../web/.next/standalone/node_modules",
        "to": "app/node_modules"
      },
      {
        "from": "../server/dist/bundle.js",
        "to": "server/bundle.js"
      },
      {
        "from": "../powerpoint/scripts/manifest.js",
        "to": "powerpoint-manifest.js"
      },
      {
        "from": "../web/.env.example",
        "to": ".env.example"
      },
      {
        "from": "../web/script.md",
        "to": "script.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../docs/PRIVACY.md",
        "to": "PRIVACY.md"
      },
      {
        "from": "../../docs/PRIVACY.it.md",
        "to": "PRIVACY.it.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Filow-${version}-win-x64-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "runAfterFinish": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "it_IT",
        "de_DE",
        "fr_FR",
        "es_ES",
        "pt_BR",
        "nl_NL",
        "pl_PL",
        "ru_RU",
        "ro_RO",
        "ja_JP",
        "zh_CN"
      ],
      "displayLanguageSelector": false,
      "shortcutName": "Filow"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Filow listens to your talk to check off your talking points and to hear OK Filow. Audio is processed on this Mac unless you choose a cloud service.",
        "NSAppleEventsUsageDescription": "Filow asks PowerPoint which slide is showing, so your talking points follow the slide show."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Stefan Butnaru",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libxt6",
        "libxrandr2",
        "libx11-6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "stefandsl",
      "repo": "filow-releases"
    },
    "copyright": "Copyright © 2026 VoidExploit",
    "asarUnpack": [
      "stt-worker.js",
      "tts-worker.js",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-*/**",
      "node_modules/uiohook-napi/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true,
      "resetAdHocDarwinSignature": true
    }
  },
  "dependencies": {
    "sherpa-onnx-node": "^2.0.1",
    "uiohook-napi": "^1.5.5"
  }
}
