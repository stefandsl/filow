{
  "name": "@filow/desktop",
  "version": "0.9.17",
  "private": true,
  "description": "Filow: the live speaking companion",
  "author": "VoidExploit",
  "license": "UNLICENSED",
  "homepage": "https://github.com/stefandsl/filow",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "icon": "node ../../scripts/make-icon.js",
    "vendor": "esbuild ../../node_modules/electron-updater/out/main.js --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=vendor/electron-updater.js",
    "predist": "npm run vendor",
    "predist:win": "npm run vendor",
    "predist:mac": "npm run vendor",
    "predist:linux": "npm run vendor"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-updater": "^6.8.11",
    "esbuild": "*"
  },
  "build": {
    "appId": "com.intelliprompter.app",
    "electronVersion": "45.2.1",
    "npmRebuild": false,
    "artifactName": "Filow-${version}-${os}-${arch}.${ext}",
    "productName": "Filow",
    "directories": {
      "output": "../../release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "slideshow.js",
      "localai.js",
      "stt-worker.js",
      "stt.js",
      "preload.js",
      "splash.html",
      "vendor/*.js",
      "picker.html",
      "picker-preload.js",
      "build/icon.png",
      "build/icon.ico",
      "build/wordmark-white.svg",
      "build/wordmark-black.svg",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "../web/.next/standalone",
        "to": "app",
        "filter": [
          "**/*",
          "!**/.env*"
        ]
      },
      {
        "from": "../server/dist/bundle.js",
        "to": "server/bundle.js"
      },
      {
        "from": "../powerpoint/scripts/manifest.js",
        "to": "powerpoint-manifest.js"
      },
      {
        "from": "../web/.env.example",
        "to": ".env.example"
      },
      {
        "from": "../web/script.md",
        "to": "script.md"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Filow-${version}-win-x64-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "runAfterFinish": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "it_IT",
        "de_DE",
        "fr_FR",
        "es_ES",
        "pt_BR",
        "nl_NL",
        "pl_PL",
        "ru_RU",
        "ja_JP",
        "zh_CN"
      ],
      "displayLanguageSelector": false,
      "shortcutName": "Filow"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "Stefan Butnaru"
    },
    "publish": {
      "provider": "github",
      "owner": "stefandsl",
      "repo": "filow-releases"
    },
    "copyright": "Copyright © 2026 VoidExploit",
    "asarUnpack": [
      "stt-worker.js",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-*/**"
    ]
  },
  "dependencies": {
    "sherpa-onnx-node": "^2.0.1"
  }
}
