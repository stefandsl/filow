FILOW_CLOUD_ORIGIN=http://127.0.0.1:4780
FILOW_CLOUD_DB=G:/claude-data/filow-cloud/accounts.sqlite
BETTER_AUTH_SECRET=
# Use a local mail inbox such as Mailpit for development. Production needs a real SMTP provider.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Filo <hello@example.com>
HOST=127.0.0.1
PORT=4780
# Optional exact IP of your immediate reverse proxy. Leave empty for direct requests.
FILOW_TRUSTED_PROXY=
# Configure these together. Create the recurring price in Stripe test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Explicitly opt in only after production acceptance. Never ship Stripe secrets in the desktop app.
FILOW_LIVE_BILLING=0
