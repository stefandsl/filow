{
  "name": "@filow/server",
  "version": "0.9.26",
  "private": true,
  "description": "Session relay: pairing codes, roles, WebSocket fan-out between one engine and its views.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/bundle.js --external:bufferutil --external:utf-8-validate",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "5.8.3"
  },
  "license": "GPL-3.0-or-later"
}
