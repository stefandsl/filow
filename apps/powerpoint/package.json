{
  "name": "@filow/powerpoint",
  "version": "0.9.28",
  "private": true,
  "description": "PowerPoint task pane add-in: speaker notes become the script, the pane follows the selected slide.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/theme.js && vite build && node scripts/manifest.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "certs": "office-addin-dev-certs install",
    "manifest": "node scripts/manifest.js",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "@filow/client": "*",
    "@filow/core": "*",
    "@filow/stt": "*",
    "@filow/ui": "*",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.400",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "typescript": "5.8.3",
    "vite": "^6.3.5"
  },
  "license": "GPL-3.0-or-later"
}
