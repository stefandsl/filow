# Web / dev: copy this file to .env.local and fill it in.
# Desktop app: on first start this file is copied to the config folder as ".env"
# (menu: Intelliprompter > Open config folder). Edit it there and restart the app.

# Required: decisions run through OpenRouter.
OPENROUTER_API_KEY=
# Fast, cheap model for yes/no decisions. Any OpenRouter model id works.
OPENROUTER_DECISION_MODEL=google/gemini-2.5-flash-lite
# Multimodal model for Screen Sense (one call per changed slide). Must accept images.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Transcription backends. In the browser (Chrome/Edge) the free Web Speech
# backend needs no key. The desktop app has no Web Speech, so it needs one of these.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ---- Sessions (phone mirror, add-ins) ----
# Password needed to create sessions and to call the spend endpoints when the
# server is reachable from other machines. Leave empty for localhost-only use.
ACCESS_PASSWORD=
# Session relay (apps/server). Behind Caddy on one domain set NEXT_PUBLIC_SESSION_URL=
# (empty = same origin). Default "auto" = same host on port 4748.
SESSION_PORT=4748
SESSION_HOST=127.0.0.1
NEXT_PUBLIC_SESSION_URL=auto
# Public URL of this deployment, sent to OpenRouter as the referer.
PUBLIC_ORIGIN=http://localhost:4747

# ---- Local mode (privacy): Cloudflare Clef via Ollama, see Settings > Local models ----
# openrouter | clef-local | clef-cloudflare. The Settings page can override per browser.
DECISION_PROVIDER=openrouter
OLLAMA_URL=http://127.0.0.1:11434
CLEF_MODEL=clef-flash
# Hosted Clef on Cloudflare Workers AI (optional)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLEF_CLOUDFLARE_MODEL=@cf/cloudflare/clef-flash
# 1 = force local providers and refuse outbound calls (desktop: menu toggle)
INTELLIPROMPTER_OFFLINE=

# ---- PII guard: anonymise text before any cloud call (ARCHITECTURE §6.10) ----
# on = Rizzo-PII sidecar when reachable + regex layer; strict = Rizzo-PII required; off = disabled
PII_GUARD=on
# Rizzo-PII local server (docker run -p 127.0.0.1:5005:5005 rizzo-pii)
PII_SERVER_URL=http://127.0.0.1:5005
